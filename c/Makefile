## Build libeita.{dylib,so} — the shared library SBCL's src/evm/ dlopens.
## Bundles the ARM64 threaded interpreter (handlers.S, generated by
## `lake exe emitARM64`), the pure-compute helpers, and the lean/c/*
## precompile primitives (built with EITA_NO_LEAN_WRAPPER so they expose
## plain-C entry points instead of Lean-object wrappers).
##
## Platform-detected: Darwin/arm64 builds libeita.dylib; Linux builds libeita.so —
## on aarch64 from handlers.S (Mach-O, converted to ELF below), on x86-64 from the
## emitted x86-64 interpreter (lake exe emitX86Interp; production Arc on x86-64 Linux).

UNAME_S := $(shell uname -s)
UNAME_M := $(shell uname -m)

CC     := clang
CXX    := clang++
BUILD  := build
LEAN_C := ../lean/c
BREW   := /opt/homebrew
## vendor/blst (git submodule, pinned release): the EIP-2537 BLS12-381
## precompiles. Built by `./build.sh` in that directory, which already
## compiles -fPIC so the static archive links into this shared library.
BLST   := ../vendor/blst
BLST_A := $(BLST)/libblst.a
## libsecp256k1 (ECRECOVER, EIP-7702 authorities, sender recovery): the pinned release, static,
## upstream's own flags. Debian's 0.2.0 recovered in 35.5 us, v0.8.0 in 30.6 (x300, 2026-11-05).
SECP   := ../vendor/secp256k1
SECP_A := $(SECP)/build/lib/libsecp256k1.a

ifeq ($(UNAME_S),Darwin)
  LIBEXT   := dylib
  ARCHFLAG := -arch arm64
  MARCH    :=                  ## Apple clang enables FEAT_SHA3 (vxarq) by default
  SHARED   := -dynamiclib
  INCDIRS  := -I$(BREW)/include -I$(BREW)/opt/openssl@3/include
  LIBDIRS  := -L$(BREW)/lib -L$(BREW)/opt/openssl@3/lib
  ## libmcl's install_name is the bare "lib/libmcl.dylib"; rewrite to @rpath so
  ## dyld resolves it via our rpath (/opt/homebrew/lib).
  RPATHS   := -Wl,-rpath,$(BREW)/lib -Wl,-rpath,$(BREW) -Wl,-rpath,$(BREW)/opt/openssl@3/lib
  POSTLINK := install_name_tool -change lib/libmcl.dylib @rpath/libmcl.dylib
else
  LIBEXT   := so
  ARCHFLAG :=
  ## Graviton2 (Neoverse N1) baseline + FEAT_SHA3 for keccak_sha3.c's vxarq
  ## intrinsics (portable across Graviton2/3/4). Apple clang enables it implicitly.
  ifeq ($(UNAME_M),x86_64)
    MARCH  := -march=x86-64-v3       ## LZCNT/BMI2 (handlers use lzcnt); Zen 3 on x86-64 Linux
  else
    MARCH  := -march=armv8.2-a+sha3
  endif
  SHARED   := -shared
  INCDIRS  := -I/usr/include -I/usr/local/include
  LIBDIRS  := -L/usr/lib -L/usr/local/lib
  ## $ORIGIN lets a deployed libeita.so find a co-bundled libmcl.so.
  RPATHS   := -Wl,-rpath,'$$ORIGIN' -Wl,-rpath,/usr/local/lib
  POSTLINK := true   ## no-op on Linux (ELF needs no install_name rewrite)
endif

LIB := libeita.$(LIBEXT)
# Batched keccak for the incremental state-root worker (#237). Deliberately its OWN
# shared library so libeita is never relinked for it — but it had no build rule at
# all and src/state/mpt.lisp only knew a hardcoded Darwin path, so on Linux the
# worker died on "the alien function eita_keccak256_batch_par is undefined" the
# first time a trie level was wide enough to batch.
KBATCH := libkeccak_batch.$(LIBEXT)

## handlers.S is emitted Mach-O ARM64 (lake exe emitARM64). On Linux the same
## ARM64 instructions need ELF directives/relocations: .text, no leading symbol
## underscore, adrp/:lo12: instead of @PAGE/@PAGEOFF. Verified on Graviton
## (#249 Phase 2). This keeps handlers.S the single committed source.
ifeq ($(UNAME_S),Darwin)
  ASM := handlers.S
else ifeq ($(UNAME_M),x86_64)
  ## #238 stage 4: the x86-64 interpreter is derived separately
  ## (lake exe emitX86Interp elf): same registry, x86-64 lowering, ELF text.
  ## Committed, like handlers.S; build.sh regenerates both and
  ## scripts/verify-host-emit.sh fails if either drifts from the Lean emitters.
  ASM := handlers-x86-elf.S
else
  ASM := $(BUILD)/handlers-elf.S
endif

CFLAGS   := $(ARCHFLAG) $(MARCH) -fPIC -O2 -DEITA_NO_LEAN_WRAPPER -I$(SECP)/include $(INCDIRS) -I$(BLST)/bindings
CXXFLAGS := $(CFLAGS) -std=c++17 -DMCL_FP_BIT=384
LDFLAGS  := $(ARCHFLAG) $(SHARED) -O2 $(LIBDIRS) $(RPATHS) -lmcl -lcrypto -lgmp

C_SRCS   := eita_compute.c tx_state.c world_slots.c $(LEAN_C)/keccak.c $(LEAN_C)/keccak_sha3.c $(LEAN_C)/sha256.c \
            $(LEAN_C)/ripemd160.c $(LEAN_C)/ecrecover.c \
            $(LEAN_C)/modexp.c $(LEAN_C)/blake2f.c $(LEAN_C)/p256verify.c \
            $(LEAN_C)/point_evaluation.c
## mcl_curve.cpp is the single owner of mcl's global active curve; bn254.cpp
## (MCL_BN_SNARK1) and bls12381.cpp (MCL_BLS12_381) both claim it per call.
CXX_SRCS := $(LEAN_C)/mcl_curve.cpp $(LEAN_C)/bn254.cpp $(LEAN_C)/bls12381.cpp

C_OBJS   := $(addprefix $(BUILD)/, $(notdir $(C_SRCS:.c=.o)))
CXX_OBJS := $(addprefix $(BUILD)/, $(notdir $(CXX_SRCS:.cpp=.o)))

PQLIB  := libeita_pq.$(LIBEXT)

all: $(LIB) $(KBATCH) $(PQLIB)

## Arc's PQ precompile (0x1800…0004) verifies SLH-DSA-SHA2-128s. arc-node does it
## with the `slh-dsa` crate, and FIPS 205 SLH-DSA is NOT SPHINCS+ round-3.1 (the
## message is prefixed with a domain separator and context length), so a lookalike
## C library would return the opposite bool at identical gas — undetectable by any
## gas gate. rust/pq is a ~60-line C-ABI shim over that same crate at the same
## pinned version, which is why this one library is built with cargo.
##   No cargo on the box?  curl https://sh.rustup.rs -sSf | sh -s -- -y
$(PQLIB): ../rust/pq/src/lib.rs ../rust/pq/Cargo.toml
	cd ../rust/pq && cargo build --release
	cp ../rust/pq/target/release/$(PQLIB) $@

# Self-contained (it carries its own keccak core) and -fvisibility=hidden, so the only
# symbols it exports are its two batch entry points. Without that it also exported
# eita_keccak256_sha3, which libeita exports too, and the winner depended on dlopen order.
$(KBATCH): $(LEAN_C)/keccak_batch.c $(LEAN_C)/keccak_sha3.c | $(BUILD)
	$(CC) $(CFLAGS) -fvisibility=hidden $(SHARED) -O2 -o $@ $(LEAN_C)/keccak_batch.c $(LEAN_C)/keccak_sha3.c -lpthread

## Mach-O -> ELF transform for the threaded interpreter asm:
##   .section __TEXT...  -> .text
##   _eita...            -> eita...        (ELF has no leading-underscore convention)
##   sym@PAGEOFF         -> :lo12:sym      (low-12 relocation)
##   sym@PAGE            -> sym            (adrp takes the bare symbol)
## ELF shared objects make every global symbol interposable, so a direct
## `adrp`/PC-relative reference to one is illegal (R_AARCH64_ADR_PREL_PG_HI21
## "may bind externally"). Mark these as `.protected`: still EXPORTED in .dynsym
## (so the SBCL JIT loader can dlsym them to patch its movabs relocs) but
## non-interposable, which makes the direct adrp refs legal in the .so. (`.hidden`
## would also fix the link but drops them from .dynsym → the JIT can't resolve
## eita_dispatch_ptr at run time.) No-op on the Mach-O Darwin build.
ELF_PROTECTED := eita_fork_tables eita_dispatch_ptr eita_next eita_sync_and_ret
$(BUILD)/handlers-elf.S: handlers.S | $(BUILD)
	sed -E 's/^\.section __TEXT,__text,regular,pure_instructions$$/.text/; s/_eita/eita/g; s/([A-Za-z0-9_]+)@PAGEOFF/:lo12:\1/g; s/@PAGE//g' $< > $@
	printf '.protected %s\n' $(ELF_PROTECTED) >> $@

$(LIB): $(ASM) $(C_OBJS) $(CXX_OBJS) $(BLST_A) $(SECP_A)
	$(CXX) $(LDFLAGS) -o $@ $^
	$(POSTLINK) $@

## Built by the submodule's own script; never patched. If this is missing the
## submodule was not initialised: git submodule update --init vendor/blst
$(BLST_A):
	cd $(BLST) && ./build.sh
## Likewise: git submodule update --init vendor/secp256k1 (needs cmake)
$(SECP_A):
	cmake -S $(SECP) -B $(SECP)/build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
	  -DCMAKE_POSITION_INDEPENDENT_CODE=ON -DSECP256K1_ENABLE_MODULE_RECOVERY=ON \
	  -DSECP256K1_BUILD_TESTS=OFF -DSECP256K1_BUILD_EXHAUSTIVE_TESTS=OFF -DSECP256K1_BUILD_BENCHMARK=OFF >/dev/null
	cmake --build $(SECP)/build >/dev/null

## #249 Phase 2: threaded-interp validation (no Lisp/Lean/precompile libs).
test_interp: $(BUILD)/test_interp
	$(BUILD)/test_interp
$(BUILD)/test_interp: test_interp.c $(ASM) eita_compute.c tx_state.c $(LEAN_C)/keccak.c evm_state.h | $(BUILD)
	$(CC) $(ARCHFLAG) -O2 -DEITA_NO_LEAN_WRAPPER -I. -I$(LEAN_C) -o $@ \
	  $(ASM) eita_compute.c tx_state.c $(LEAN_C)/keccak.c test_interp.c

$(BUILD)/eita_compute.o: eita_compute.c | $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD)/tx_state.o: tx_state.c tx_state.h tx_arena.h | $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

test: $(BUILD)/test_tx_state $(BUILD)/test_compute $(BUILD)/test_world_slots
	$(BUILD)/test_tx_state
	$(BUILD)/test_compute
	$(BUILD)/test_world_slots

$(BUILD)/world_slots.o: world_slots.c world_slots.h | $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

# The native slot tables against a reference finite map, under ASan + UBSan. The CBMC
# harness (bounds, overflow, pointers; equivalence to the model at small sizes): cbmc/run.sh.
test_world_slots: $(BUILD)/test_world_slots
	$(BUILD)/test_world_slots
# The same binary on a trace of the Lean model (lean/WorldSlotsVectors.lean).
test_world_slots_model: $(BUILD)/test_world_slots
	cd ../lean && lake build worldSlotsVectors >/dev/null && lake env ./.lake/build/bin/worldSlotsVectors 50000 > ../c/$(BUILD)/ws-vectors.txt
	$(BUILD)/test_world_slots $(BUILD)/ws-vectors.txt
$(BUILD)/test_world_slots: test_world_slots.c world_slots.c world_slots.h | $(BUILD)
	$(CC) -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -Wall -Wextra -o $@ test_world_slots.c world_slots.c

$(BUILD)/test_tx_state: test_tx_state.c tx_state.c tx_state.h tx_arena.h | $(BUILD)
	$(CC) $(ARCHFLAG) -O1 -o $@ test_tx_state.c tx_state.c

# EIP-2537 BLS12-381 conformance against the chain's own answers. The oracle is
# lean/c/testdata/bls12381-vectors.json (canonical outputs captured from Arc
# block 21 142 242 tx 34 plus eth_call). Also checks that interleaving the
# BLS12-381 and BN254 precompiles does not corrupt mcl's global curve state.
test_bls12381: $(BUILD)/test_bls12381
	DYLD_LIBRARY_PATH=$(BREW)/lib $(BUILD)/test_bls12381 $(LEAN_C)/testdata/bls12381-vectors.json
$(BUILD)/test_bls12381: test_bls12381.cpp $(LEAN_C)/bls12381.cpp $(LEAN_C)/bn254.cpp \
                        $(LEAN_C)/mcl_curve.cpp $(LEAN_C)/mcl_curve.h $(BLST_A) | $(BUILD)
	$(CXX) $(CXXFLAGS) $(ARCHFLAG) -o $@ test_bls12381.cpp \
	  $(LEAN_C)/bls12381.cpp $(LEAN_C)/bn254.cpp $(LEAN_C)/mcl_curve.cpp \
	  $(BLST_A) $(LIBDIRS) $(RPATHS) -lmcl
	-$(POSTLINK) $@

# EIP-4844 point evaluation (0x0a) against the c-kzg-4844 verify_kzg_proof vectors.
test_point_evaluation: $(BUILD)/test_point_evaluation
	$(BUILD)/test_point_evaluation $(LEAN_C)/testdata/kzg-verify-proof-vectors.txt
$(BUILD)/test_point_evaluation: test_point_evaluation.c $(LEAN_C)/point_evaluation.c $(LEAN_C)/sha256.c $(BLST_A) | $(BUILD)
	$(CC) $(ARCHFLAG) -O2 -DEITA_NO_LEAN_WRAPPER -I$(BLST)/bindings -o $@ $^

# DIV/MOD/SDIV/SMOD/ADDMOD/MULMOD (one word-wise division) and SAR (#258) against
# GMP, ~2.5M cases per helper, under ASan + UBSan. Needs libgmp (brew gmp / libgmp-dev).
test_modexp: $(BUILD)/test_modexp
	$(BUILD)/test_modexp
$(BUILD)/test_modexp: test_modexp.c $(LEAN_C)/modexp.c | $(BUILD)
	$(CC) -O1 -g -fsanitize=address,undefined -DEITA_NO_LEAN_WRAPPER $(INCDIRS) -o $@ test_modexp.c $(LEAN_C)/modexp.c $(LIBDIRS) $(RPATHS) -lcrypto -lgmp
test_compute: $(BUILD)/test_compute
	$(BUILD)/test_compute
$(BUILD)/test_compute: test_compute.c eita_compute.c evm_state.h | $(BUILD)
	$(CC) $(ARCHFLAG) $(MARCH) -O2 -g -fsanitize=address,undefined -fno-sanitize-recover=all \
	  $(INCDIRS) -o $@ test_compute.c eita_compute.c $(LIBDIRS) $(RPATHS) -lgmp

$(BUILD)/%.o: $(LEAN_C)/%.c | $(BUILD)
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD)/%.o: $(LEAN_C)/%.cpp | $(BUILD)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

$(BUILD):
	mkdir -p $@

clean:
	rm -rf $(BUILD) libeita.dylib libeita.so

.PHONY: all clean test test_compute test_modexp test_bls12381 test_point_evaluation
