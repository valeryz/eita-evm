;;;; tests/world-slots.lisp — the native slot tables (c/world_slots.c) through the world's
;;;; storage API, randomized, against two references: a finite map (the semantics:
;;;; lean/Evm/CL/WorldSlotsModel.lean) and the Lisp packed table the native one replaced
;;;; (state/world.lisp before owner note 6 step 2), whose walk order the native table must
;;;; keep (a journaled wipe's entries, layer files and observers walk an account's slots).
;;;; Ops: writes (zero-removing and lazy-world zero-keeping), overwrites, reads of absent
;;;; keys, colliding keys, growth, frames reverted in reverse order, wipes, un-creates,
;;;; copies. Run: (eita.test:run-all :only '("world-slots")).

(defpackage #:eita.test.world-slots (:use #:cl #:eita.state))
(in-package #:eita.test.world-slots)

;;; The replaced Lisp table (hash, linear probe, tombstones, growth), for the walk order.
(defstruct (ref (:constructor make-ref ())) (cap 4) (count 0) (used 0)
  (keys (make-array 4 :initial-element nil)) (vals (make-array 4)) (state (make-array 4 :initial-element 0)))
(defun ref-hash (k mask)
  (logand (ash (logand (+ (logand (* (ldb (byte 64 0) k) #x9E3779B97F4A7C15) #xFFFFFFFFFFFFFFFF)
                          (ldb (byte 64 64) k)) #xFFFFFFFFFFFFFFFF) -17) mask))
(defun ref-find (r k)
  (let ((mask (1- (ref-cap r))) (tomb -1))
    (loop with i = (ref-hash k mask)
          do (case (aref (ref-state r) i)
               (0 (return (- -1 (if (>= tomb 0) tomb i))))
               (2 (when (< tomb 0) (setf tomb i)))
               (t (when (= (aref (ref-keys r) i) k) (return i))))
             (setf i (logand (1+ i) mask)))))
(defun ref-put (r k v)
  (when (>= (* 4 (1+ (ref-used r))) (* 3 (ref-cap r)))
    (let ((old (loop for i below (ref-cap r) when (= 1 (aref (ref-state r) i))
                     collect (cons (aref (ref-keys r) i) (aref (ref-vals r) i))))
          (cap (if (> (* 2 (ref-count r)) (ref-cap r)) (* 2 (ref-cap r)) (ref-cap r))))
      (setf (ref-cap r) cap (ref-count r) 0 (ref-used r) 0 (ref-keys r) (make-array cap :initial-element nil)
            (ref-vals r) (make-array cap) (ref-state r) (make-array cap :initial-element 0))
      (loop for (k2 . v2) in old do (ref-put r k2 v2))))
  (let ((i (ref-find r k)))
    (when (minusp i)
      (setf i (- -1 i))
      (when (= 0 (aref (ref-state r) i)) (incf (ref-used r)))
      (setf (aref (ref-state r) i) 1 (aref (ref-keys r) i) k)
      (incf (ref-count r)))
    (setf (aref (ref-vals r) i) v)))
(defun ref-remove (r k)
  (let ((i (ref-find r k))) (unless (minusp i) (setf (aref (ref-state r) i) 2) (decf (ref-count r)))))
(defun ref-walk (r)
  (loop for i below (ref-cap r) when (= 1 (aref (ref-state r) i))
        collect (cons (aref (ref-keys r) i) (aref (ref-vals r) i))))

(defparameter *ok* t)
(defparameter *checks* 0)
(defmacro check (form fmt &rest args)
  `(progn (incf *checks*)
          (unless ,form (when *ok* (format t "  FAIL: ~?~%" ,fmt (list ,@args))) (setf *ok* nil))))

(defvar *rs* (sb-ext:seed-random-state 20261107))
(defun rnd (n) (random n *rs*))
(defparameter *addrs* (loop for i below 24 collect (+ #x1000 (* i #x10001) (if (evenp i) (ash 1 150) 0))))
(defun rkey ()
  "Slot keys built to collide: equal low limbs (one hash) with other high limbs."
  (let ((r (rnd 500)))
    (+ (mod r 37) (ash (mod r 5) 64) (if (zerop (mod r 3)) (ash (floor r 37) 128) 0)
       (if (= 1 (mod r 7)) (ash (1- (ash 1 64)) 192) 0))))
(defun rval () (case (rnd 4) (0 0) (1 (rnd 1000)) (t (rnd (ash 1 256)))))

(defun run (keep-zero)
  (let* ((eita.state::*keep-zero-slots* keep-zero)
         (w (make-world)) (model (make-hash-table :test 'equal)) (refs (make-hash-table)))
    (flet ((set! (a k v)
             (world-storage-set w a k v)
             (let ((r (or (gethash a refs) (setf (gethash a refs) (make-ref)))))
               (if (and (zerop v) (not keep-zero))
                   (progn (remhash (cons a k) model) (ref-remove r k))
                   (progn (setf (gethash (cons a k) model) v) (ref-put r k v)))))
           (wipe! (a how)
             (if (eq how :uncreate) (account-uncreate! w a 1) (eita.state::world-storage-wipe! w a))
             (remhash a refs)
             (loop for key being the hash-keys of model when (eql (car key) a) do (remhash key model)))
           (verify (w where)
             (dolist (a *addrs*)
               (let* ((tb (world-accts w)) (id (eita.state::acct-table-intern tb a))
                      (walk '()) (r (gethash a refs)))
                 (acct-slots-map (lambda (k v) (push (cons k v) walk)) tb id)
                 (setf walk (nreverse walk))
                 (check (eq (null r) (null (acct-slots tb id))) "~A: table existence of ~X" where a)
                 (check (equal walk (if r (ref-walk r) '())) "~A: walk of ~X differs from the Lisp table's" where a)
                 (dolist (kv walk)
                   (check (eql (gethash (cons a (car kv)) model) (cdr kv)) "~A: walk value ~X/~X" where a (car kv)))))
             (maphash (lambda (key v)
                        (check (eql (world-storage-get w (car key) (cdr key)) v) "~A: get ~X/~X" where (car key) (cdr key))
                        (check (eita.state::acct-slot-present-p (world-accts w) (eita.state::acct-table-intern (world-accts w) (car key)) (cdr key))
                               "~A: present ~X/~X" where (car key) (cdr key)))
                      model)))
      (dotimes (round 40)
        (let ((journal '()) (revert (zerop (rnd 3))))
          (dotimes (op 1500)
            (let ((a (nth (rnd (length *addrs*)) *addrs*)) (k (rkey)) (r (rnd 100)))
              (cond ((< r 70)
                     (push (list a k (gethash (cons a k) model) (nth-value 1 (gethash (cons a k) model))) journal)
                     (set! a k (if (< r 20) 0 (rval))))
                    ((< r 97)
                     (check (eql (world-storage-get w a k) (gethash (cons a k) model 0)) "get ~X/~X" a k))
                    ((not revert) (wipe! a (if (evenp r) :wipe :uncreate))))))
          (when revert                        ; the journal's type-0 restore, newest first
            (loop for (a k old present) in journal
                  do (if present
                         (set! a k old)
                         (progn (let ((eita.state::*keep-zero-slots* nil)) (world-storage-set w a k 0))
                                (remhash (cons a k) model)
                                (ref-remove (gethash a refs) k)))))
          (verify w (format nil "round ~D" round))))
      (verify (copy-world* w) "copy")
      ;; growth: one account through many doublings
      (let ((a (first *addrs*)))
        (dotimes (i 20000) (set! a (+ (* i #x100000001) (ash i 100)) (1+ i)))
        (verify w "growth")))))

(run nil)
(run t)
(format t "  world-slots: ~D checks~%" *checks*)
(eita.test:finish :code (if *ok* 0 1))
