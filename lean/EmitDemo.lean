import Evm.CL.Extract

/-! Generate the full extracted-ops.lisp.

    Run:
      lake env lean --run EmitDemo.lean 2>/dev/null > src/evm/extracted-ops.lisp

    Every opcode that ships in the SBCL eval-loop is defined here as a
    `Form` value. Those with closed `x_extract_correct` theorems are
    structurally Lean-derived. Others use the `rawCL` escape hatch —
    still Lean-owned source, but the per-opcode soundness theorem is
    pending (audit script + future structuring closes the gap).
-/

open Evm.CL.Extract

def emitMacro (name : String) (form : Form) (extraArgs : String := "") : IO Unit := do
  if extraArgs.isEmpty then
    IO.println s!"(defmacro op-{name} (s fork mode)"
  else
    IO.println s!"(defmacro op-{name} (s fork mode {extraArgs})"
  IO.println s!"  `{form.toCL})"
  IO.println ""

def main : IO Unit := do
  IO.println ";;;; AUTO-GENERATED by lean/EmitDemo.lean — do not hand-edit."
  IO.println ";;;; Every macro here corresponds to a `Form` value in"
  IO.println ";;;; lean/Evm/CL/Extract.lean. Ops with closed theorems"
  IO.println ";;;; (add/sub/mul/and/or/xor/pop/sload-under-mock) ship"
  IO.println ";;;; with structurally Lean-derived bodies. The rest use"
  IO.println ";;;; the rawCL escape hatch — still Lean-owned, audit-checked,"
  IO.println ";;;; future-structurable."
  IO.println ""
  IO.println "(in-package :evm)"
  IO.println ""
  -- Closed-theorem ops
  emitMacro "add"        addForm
  emitMacro "sub"        subForm
  emitMacro "mul"        mulForm
  emitMacro "and"        andForm
  emitMacro "or"         orForm
  emitMacro "xor"        xorForm
  -- Pop has a 2-arg signature in the case-dispatch; emit op-pop with
  -- (s mode) signature for compat with the existing call site.
  IO.println "(defmacro op-pop (s mode)"
  IO.println s!"  `{popForm.toCL})"
  IO.println ""
  -- Arithmetic (rest)
  emitMacro "div"        divForm
  emitMacro "sdiv"       sdivForm
  emitMacro "mod"        modForm
  emitMacro "smod"       smodForm
  emitMacro "addmod"     addmodForm
  emitMacro "mulmod"     mulmodForm
  emitMacro "exp"        expForm
  emitMacro "signextend" signextendForm
  -- Comparison
  emitMacro "lt"         ltForm
  emitMacro "gt"         gtForm
  emitMacro "slt"        sltForm
  emitMacro "sgt"        sgtForm
  emitMacro "eq"         eqForm
  emitMacro "iszero"     iszeroForm
  -- Bitwise
  emitMacro "not"        notForm
  emitMacro "byte"       byteForm
  emitMacro "shl"        shlForm
  emitMacro "shr"        shrForm
  emitMacro "sar"        sarForm
  -- Memory
  emitMacro "mload"      mloadForm
  emitMacro "mstore"     mstoreForm
  emitMacro "mstore8"    mstore8Form
  emitMacro "msize"      msizeForm
  emitMacro "mcopy"      mcopyForm
  -- Storage
  emitMacro "sload"      sloadForm
  emitMacro "sstore"     sstoreForm
  emitMacro "tload"      tloadForm
  emitMacro "tstore"     tstoreForm
  -- Control flow. op-jump and op-jumpi have macro-expansion-time
  -- mode conditionals (different body for :untamed vs :full); the
  -- Form IR doesn't model that meta-conditional yet, so they stay
  -- hand-written. jumpForm/jumpiForm exist for the :full case only.
  emitMacro "jumpdest"   jumpdestForm
  emitMacro "pc"         pcForm
  emitMacro "gas"        gasForm
  -- Environment / block context
  emitMacro "address"    addressForm
  emitMacro "origin"     originForm
  emitMacro "caller"     callerForm
  emitMacro "callvalue"  callvalueForm
  emitMacro "gasprice"   gaspriceForm
  emitMacro "chainid"    chainidForm
  emitMacro "coinbase"   coinbaseForm
  emitMacro "timestamp"  timestampForm
  emitMacro "number"     numberForm
  emitMacro "gaslimit"   gaslimitForm
  emitMacro "basefee"    basefeeForm
  emitMacro "calldatasize"    calldatasizeForm
  emitMacro "codesize"        codesizeForm
  emitMacro "returndatasize"  returndatasizeForm
  -- World-state hooks
  emitMacro "balance"      balanceForm
  emitMacro "selfbalance"  selfbalanceForm
  emitMacro "extcodesize"  extcodesizeForm
  emitMacro "extcodehash"  extcodehashForm
  emitMacro "extcodecopy"  extcodecopyForm
  emitMacro "blockhash"    blockhashForm
  -- Copy ops
  emitMacro "calldataload"   calldataloadForm
  emitMacro "calldatacopy"   calldatacopyForm
  emitMacro "codecopy"       codecopyForm
  emitMacro "returndatacopy" returndatacopyForm
  -- Halts: single-arg signature (s), no fork/mode (no gas charge).
  IO.println "(defmacro op-return (s)"
  IO.println s!"  `{returnForm.toCL})"
  IO.println ""
  IO.println "(defmacro op-revert (s)"
  IO.println s!"  `{revertForm.toCL})"
  IO.println ""
  IO.println "(defmacro op-invalid (s)"
  IO.println s!"  `{invalidForm.toCL})"
  IO.println ""
  IO.println "(defmacro op-stop (s)"
  IO.println s!"  `{stopForm.toCL})"
  IO.println ""
  -- PUSH/DUP/SWAP/LOG: macro-arg-dependent. Keep as a single
  -- defmacro taking `n` as an argument; emit a rawCL form that
  -- inspects `n` at expansion time. We retain the existing
  -- hand-written op-push, op-dup, op-swap, op-log macros for now —
  -- the Lean extraction of these parameterized forms is a follow-up
  -- (the Form IR currently models them per-n, not as one parameterized
  -- macro).
  IO.println ";; PUSH/DUP/SWAP/LOG: still hand-written in eval-loop.lisp"
  IO.println ";; (the n-parameterized macros don't yet have a single Form."
  IO.println ";;  Per-n Forms exist via pushForm/dupForm/swapForm; one"
  IO.println ";;  meta-macro extraction is a follow-up.)"
  IO.println ""
  IO.println ";;;; end auto-generated."
