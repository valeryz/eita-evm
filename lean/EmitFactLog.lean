/-
  EmitFactLog.lean — `lake exe emitFactLog <lisp|python|vectors>` prints the fact log's
  binary format from its one definition (lean/Evm/FactLog/Format.lean):

    lisp     src/generated/factlog-schema.lisp       the tables' column types + layout constants
    python   scripts/generated/factlog_schema.py     the same, as a Python module
    vectors  scripts/generated/factlog-vectors.sexp  per table: the sample rows (as the text
             writer prints them), the raw-codec group bytes (hex) and the content hash

  scripts/verify-factlog-emit.sh regenerates all three and fails on drift, then feeds the
  vectors to src/factlog/format.lisp and scripts/factlog.py: each must decode the group to
  exactly the rows, and encode the rows to exactly the bytes.
-/
import Evm.FactLog.Examples
import Evm.FactLog.History

open Evm.FactLog

def hexDigit (n : Nat) : Char := "0123456789abcdef".toList.getD n (Char.ofNat 63)

def hexOf (bs : Bytes) : String :=
  String.ofList (bs.foldr (fun b acc => hexDigit (b.toNat / 16) :: hexDigit (b.toNat % 16) :: acc) [])

/-- The index key bytes of a sample row of an indexed table. -/
def keyOf (table : String) (r : Row) : Bytes :=
  match table, r with
  | "storage_diff", _ :: _ :: .nat a :: .nat s :: _ => storageKeyBytes a s
  | "account_diff", _ :: _ :: .nat a :: _ => accountKeyBytes a
  | _, _ => []

/-- The index section of a table's samples: perm, bloom size, bloom bytes. -/
def sampleIndex (table : String) : Option (List Nat × Nat × Bytes) :=
  let rows := samples table
  let keys := rows.map (keyOf table)
  let distinct := (keys.eraseDups).length
  let m := bloomBitsFor distinct
  let bloom := bloomBytesOf m (bloomOf m bloomK keys)
  (encodeIndex (permOf keys) bloomK bloom).map fun _ => (permOf keys, m, bloom)

/-- A value as the text fact log prints it (one owner of that form: the text writer). -/
def valueText : Value → String
  | .nat n => toString n
  | .int z => toString z
  | .none => "NIL"
  | .nats l => "(" ++ " ".intercalate (l.map toString) ++ ")"
  | .bytes b => "\"" ++ hexOf b ++ "\""

def rowText (r : Row) : String := "(" ++ " ".intercalate (r.map valueText) ++ ")"

def lispKeyword (t : ColType) : String := ":" ++ t.name

def emitLisp : IO Unit := do
  IO.println ";;;; GENERATED by `lake exe emitFactLog lisp` from lean/Evm/FactLog/Format.lean — do not edit."
  IO.println ";;;; The fact log's binary shard format: layout constants and the tables' column types."
  IO.println s!"(:magic ({" ".intercalate (magic.map (toString ·.toNat))})"
  IO.println s!" :header-fixed {headerLen 0} :dir-entry 9 :codec-raw 0 :codec-zstd 1"
  IO.println s!" :index-magic ({" ".intercalate (indexMagic.map (toString ·.toNat))}) :index-header {indexHeaderLen} :bloom-k {bloomK}"
  IO.println " :indexed (\"storage_diff\" \"account_diff\")"
  IO.println " :tables ("
  for t in tables do
    IO.println s!"  (\"{t.name}\" {" ".intercalate (t.cols.map lispKeyword)})"
  IO.println "  ))"

def emitPython : IO Unit := do
  IO.println "# GENERATED by `lake exe emitFactLog python` from lean/Evm/FactLog/Format.lean -- do not edit."
  IO.println "# The fact log's binary shard format: layout constants and the tables' column types."
  IO.println s!"MAGIC = bytes([{", ".intercalate (magic.map (toString ·.toNat))}])"
  IO.println s!"HEADER_FIXED = {headerLen 0}   # bytes before the per-column directory"
  IO.println "DIR_ENTRY = 9       # codec u8 + rawLen u32 + encLen u32"
  IO.println "CODEC_RAW, CODEC_ZSTD = 0, 1"
  IO.println s!"INDEX_MAGIC = bytes([{", ".intercalate (indexMagic.map (toString ·.toNat))}])"
  IO.println s!"INDEX_HEADER = {indexHeaderLen}   # bytes before perm"
  IO.println s!"BLOOM_K = {bloomK}"
  IO.println "INDEXED = (\"storage_diff\", \"account_diff\")   # tables with a history index"
  IO.println "TABLES = {"
  for t in tables do
    IO.println s!"    \"{t.name}\": ({", ".intercalate (t.cols.map fun c => "\"" ++ c.name ++ "\"")},),"
  IO.println "}"

def emitVectors : IO Unit := do
  IO.println ";; GENERATED by `lake exe emitFactLog vectors`: per table, the sample rows (text form),"
  IO.println ";; the raw-codec group bytes (hex) and the rows' content hash (FNV-1a 64, hex)."
  for t in tables do
    let rows := samples t.name
    match sampleGroup t.name, contentHash t.cols rows with
    | some e, some h =>
      IO.println s!"(:table \"{t.name}\""
      IO.println s!" :rows ({" ".intercalate (rows.map rowText)})"
      IO.println s!" :group \"{hexOf e}\""
      IO.println s!" :content \"{hexOf (encLE 8 h.toNat).reverse}\""
      match sampleIndex t.name, (sampleIndex t.name).bind fun (p, _, b) => encodeIndex p bloomK b with
      | some (perm, m, bloom), some ie =>
        if t.name ∈ ["storage_diff", "account_diff"] then
          IO.println s!" :perm ({" ".intercalate (perm.map toString)}) :bloom-bits {m} :bloom \"{hexOf bloom}\""
          IO.println s!" :index \"{hexOf ie}\")"
        else IO.println ")"
      | _, _ => IO.println ")"
    | _, _ => throw (IO.userError s!"samples of {t.name} do not encode")
  -- the legacy block group (7 columns, before the blob columns): readers must take it too
  match legacyBlockGroup, contentHash (colsOf "block") legacyBlockRows with
  | some e, some h =>
    IO.println "(:table \"block\" :legacy t"
    IO.println s!" :rows ({" ".intercalate (legacyBlockRows.map rowText)})"
    IO.println s!" :group \"{hexOf e}\""
    IO.println s!" :content \"{hexOf (encLE 8 h.toNat).reverse}\")"
  | _, _ => throw (IO.userError "the legacy block rows do not encode")

def main (args : List String) : IO UInt32 := do
  match args with
  | ["lisp"] => emitLisp; pure 0
  | ["python"] => emitPython; pure 0
  | ["vectors"] => emitVectors; pure 0
  | _ => IO.eprintln "usage: emitFactLog lisp|python|vectors"; pure 2
