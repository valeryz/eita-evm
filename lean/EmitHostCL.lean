import Evm.CL.HostEmit
import Evm.CL.GasEmit
import Evm.CL.GasEmitPrague  -- emitted tx-gas formulas = the Prague spec, proved; built with the emitter
import Evm.CL.GasEmitShanghai  -- emitted EIP-3860 cap decision = the Shanghai spec, proved; same
import Evm.CL.GasEmitParis  -- emitted block reward = the Paris spec's schedule (0 from the Merge), proved; same
import Evm.CL.GasEmitCancun  -- emitted blob base fee = the fork-typed EIP-4844/7691 spec, proved; same
import Evm.CL.GasEmitLondon  -- emitted EIP-1559 next base fee = the London spec, proved; same
import Evm.CL.HeaderEmit  -- emitted validate_header = the fork-typed spec, proved; same
import Evm.Arc.Spec.NativeCoin
import Evm.Arc.Spec.Pq
import Evm.Arc.Spec.BlockSystem
import Evm.CL.ForkEmit
import Evm.CL.EffectSelfdestruct  -- the derived cb-selfdestruct effect; proved in EffectSelfdestructProof
import Evm.CL.EffectSettle        -- the derived fee settlement; proved in EffectSettleProof
import Evm.CL.EffectEndTx         -- the derived end-of-tx deletions; proved in EffectEndTxProof
import Evm.CL.EffectCreate        -- the derived cb-create effect; proved in EffectCreateProof
import Evm.CL.EffectCall          -- the derived cb-call effect; proved in EffectCallProof
import Evm.CL.EffectTx            -- the derived apply-tx effect; proved in EffectTxProof
import Evm.CL.EffectSystem        -- the derived system call; proved in EffectSystemProof
import Evm.CL.EffectBlock         -- the derived block credits; proved in EffectBlockProof
import Evm.CL.ARM64.RunProgramDenote  -- the JIT dispatch-table builder; proved in the same file

/-! Emit the host-layer decision logic as Common Lisp.

    Run:
      lake exe emitHostCL > ../src/generated/host.lisp

    Each function here is the `toCL` of a single `Evm.CL.HostEmit` IR term,
    so the emitted CL is the Lean-proved semantics by construction. The
    `world-account-present-p` / `world-account-empty-p` it calls are the
    hand-written, runtime-pluggable world seam in the harness. -/

open Evm.CL.HostEmit
open Evm.CL.GasEmit (Expr sha256Gas ripemd160Gas identityGas ecrecoverGas p256verifyGas rip7212Gas pointEvaluationGas authIntrinsicPerAuth authRefundExisting
  bn256AddGas bn256MulGas bn256PairingGas intrinsicGas codeDepositGas createGas createInitcodeOversize
  selfdestructRefund refundCap retain63of64 newAccountFee blockBaseReward
  uncleInclusionBonus uncleReward effectiveGasPrice priorityFee calldataFloorGas txGasUsed selfdestructColdGas delegateAccessGas
  fakeExponentialCL blobBaseFee maxBlobGasPerBlock txMaxGasLimit
  blsG1AddGas blsG2AddGas blsMapFpToG1Gas blsMapFp2ToG2Gas blsPairingGas
  blsG1MsmBase blsG2MsmBase blsG1MsmDiscounts blsG2MsmDiscounts
  blsG1MsmMaxDiscount blsG2MsmMaxDiscount)

def main : IO Unit := do
  IO.println ";;;; AUTO-GENERATED by lean/EmitHostCL.lean — do not hand-edit."
  IO.println ";;;; Emitted from Evm.CL.HostEmit; semantics proved in Lean."
  IO.println "(in-package :eita.evm)"
  IO.println ""
  IO.println ";; CREATE address-collision (EELS not account_deployable, EIP-684): abort and consume"
  IO.println ";; ALL forwarded gas when the new address has code or nonce>0 (no EIP-7610 storage"
  IO.println ";; leg: execution-specs #3417; a creation over storage wipes it)."
  IO.println s!"(defun spec-create-collision-p ({" ".intercalate createCollision.vars})"
  IO.println s!"  {createCollision.toCL})"
  IO.println ""
  IO.println ";; The SELFDESTRUCT host effect (Evm.CL.EffectSelfdestruct.term, an EffectIR term),"
  IO.println ";; proved equal to every fork's SELFDESTRUCT in Evm.CL.EffectSelfdestructProof."
  IO.println ";; Returns the gas beyond the native base (cold access + new account)."
  IO.println Evm.CL.EffectSelfdestruct.termCL
  IO.println ""
  IO.println ";; The tx fee settlement (Evm.CL.EffectSettle: refundTerm, then coinbaseTerm), proved"
  IO.println ";; equal to every fork's settleFees in Evm.CL.EffectSettleProof. run-evm-tx calls the"
  IO.println ";; two in this order; the second is the default *chain-fee-hook*. Credits are deltas."
  IO.println Evm.CL.EffectSettle.refundCL
  IO.println ""
  IO.println Evm.CL.EffectSettle.coinbaseCL
  IO.println ""
  IO.println ";; The end of a tx (Evm.CL.EffectEndTx: destroyTerm, then sweepTerm), proved equal to"
  IO.println ";; every fork's destroyAccounts / finishTx in Evm.CL.EffectEndTxProof: the"
  IO.println ";; accounts_to_delete, then (Spurious Dragon+) the touched dead accounts."
  IO.println Evm.CL.EffectEndTx.destroyCL
  IO.println ""
  IO.println Evm.CL.EffectEndTx.sweepCL
  IO.println ""
  IO.println ";; The CREATE/CREATE2 host effect (Evm.CL.EffectCreate.term), proved equal to every"
  IO.println ";; fork's CREATE (Evm.Frontier.Vm.Create.run) in Evm.CL.EffectCreateProof. Returns"
  IO.println ";; (values gas-used pushed-word return-data)."
  IO.println Evm.CL.EffectCreate.termCL
  IO.println ""
  IO.println ";; The CALL-family host effect (Evm.CL.EffectCall.term), proved equal to every fork's"
  IO.println ";; CALL/CALLCODE/DELEGATECALL/STATICCALL (Evm.Frontier.Vm.Call.run) in"
  IO.println ";; Evm.CL.EffectCallProof. Returns (values gas-used flag return-data)."
  IO.println Evm.CL.EffectCall.termCL
  IO.println ""
  IO.println ";; A transaction's effect up to the end of its message (Evm.CL.EffectTx.term): the"
  IO.println ";; validation, the upfront charge, the accessed sets, EIP-7702's authorizations and"
  IO.println ";; delegation, the message. Proved against every fork's processTransaction"
  IO.println ";; (Evm.Frontier.Vm.Tx) in Evm.CL.EffectTxProof. Returns (values gas-used flag rejection)."
  IO.println Evm.CL.EffectTx.termCL
  IO.println ""
  IO.println ";; A system transaction's effect (Evm.CL.EffectSystem.term): EELS"
  IO.println ";; process_unchecked_system_transaction's message (the chain rule's warm-up, from Prague the"
  IO.println ";; target's delegation, the call), and process_checked_system_transaction's code rule. Proved"
  IO.println ";; against every fork's Evm.Frontier.Vm.System in Evm.CL.EffectSystemProof. Returns"
  IO.println ";; (values gas-used flag rejection)."
  IO.println Evm.CL.EffectSystem.termCL
  IO.println ""
  IO.println ";; A block's own credits after its txs (Evm.CL.EffectBlock.credits): the block and"
  IO.println ";; ommer rewards (to London), the EIP-4895 withdrawals (from Shanghai). Proved equal to"
  IO.println ";; every fork's Evm.Frontier.Vm.Block.postBlock in Evm.CL.EffectBlockProof."
  IO.println Evm.CL.EffectBlock.creditsCL
  IO.println ""
  IO.println ";; The JIT dispatch table (RunProgramDenote.build; = the manifest scan: tableLookup_build)."
  IO.println ";; The replay's JIT loader and tests/audit-jit.lisp call it; the caller frees the table."
  IO.println Evm.CL.ARM64.RunProgramDenote.buildCL
  IO.println ""
  IO.println ";; CL-side revert-journal-to dispatch (world-state entry types;"
  IO.println ";; native types are reverted by eita_ts_revert)."
  IO.println s!"(defun spec-restore-journal-entry (type addr slot old)"
  IO.println s!"  (declare (ignorable slot old))"
  IO.println s!"  {revertDispatchCL})"
  IO.println ""
  IO.println ";; BLOCKHASH validity window (EELS block_hash): n < cur AND cur <= n+256"
  IO.println ";; (oldest valid block = cur-256, inclusive). No subtraction => the #265"
  IO.println ";; off-by-one is unrepresentable."
  IO.println s!"(defun spec-blockhash-valid (n cur)"
  IO.println s!"  {blockhashValidCL})"
  IO.println ""
  IO.println ";; EXTCODEHASH (EIP-1052): the hash is 0 iff the account is dead"
  IO.println ";; (EELS EMPTY_ACCOUNT = absent or all-zero). Else keccak256(code), with"
  IO.println ";; keccak256(\"\")=empty-code-hash for a live codeless account. Reuses the"
  IO.println ";; same `empty` world-seam query as the new-account charge => one dead test."
  IO.println s!"(defun spec-extcodehash-zero-p (addr)"
  IO.println s!"  {extcodehashZero.toCL})"
  IO.println ""
  IO.println ";; MODEXP (0x05) gas, fork-aware (EIP-198 pre-Berlin / EIP-2565 Berlin+)."
  IO.println ";; Emitted from Evm.CL.GasEmit.modexpGas; eval kernel-checked vs the EIP"
  IO.println ";; numbers (13056 / 1360 / exp_len>32). Byte-reading is the CL seam."
  IO.println s!"(defun spec-modexp-gas (base-sz exp-sz mod-sz exp-head fork-ord)"
  IO.println s!"  {Evm.CL.GasEmit.modexpGas.toCL})"
  IO.println ""
  IO.println ";; EIP-4844 fake_exponential (EELS cancun/vm/gas.py): the integer Taylor series behind"
  IO.println ";; the blob base fee. The one loop in the emitted formulas; `.fakeExp` terms call it."
  IO.println s!"(defun spec-fake-exponential (factor numerator denominator)"
  IO.println s!"  {fakeExponentialCL})"
  IO.println ""
  IO.println ";; Precompile gas (EIP-198/196/197/1108) and tx/CREATE/refund/reward gas,"
  IO.println ";; all emitted from Evm.CL.GasEmit — eval kernel-checked vs published numbers."
  let defs : List (String × String × Expr) :=
    [ ("spec-sha256-gas",        "(len)",                         sha256Gas)
    , ("spec-ripemd160-gas",     "(len)",                         ripemd160Gas)
    , ("spec-identity-gas",      "(len)",                         identityGas)
    , ("spec-ecrecover-gas",     "()",                            ecrecoverGas)
    , ("spec-p256verify-gas",    "()",                            p256verifyGas)
    , ("spec-rip7212-gas",       "()",                            rip7212Gas)
    , ("spec-point-evaluation-gas", "()",                         pointEvaluationGas)
    , ("spec-auth-intrinsic-per-auth", "()",                      authIntrinsicPerAuth)
    , ("spec-auth-refund-existing",    "()",                      authRefundExisting)
    , ("spec-bn256-add-gas",     "(fork-ord)",                    bn256AddGas)
    , ("spec-bn256-mul-gas",     "(fork-ord)",                    bn256MulGas)
    , ("spec-bn256-pairing-gas", "(len fork-ord)",                bn256PairingGas)
    -- EIP-2537 BLS12-381 (Prague+), costs measured from the canonical client.
    , ("spec-bls-g1add-gas",         "()",     blsG1AddGas)
    , ("spec-bls-g2add-gas",         "()",     blsG2AddGas)
    , ("spec-bls-map-fp-to-g1-gas",  "()",     blsMapFpToG1Gas)
    , ("spec-bls-map-fp2-to-g2-gas", "()",     blsMapFp2ToG2Gas)
    , ("spec-bls-pairing-gas",       "(len)",  blsPairingGas)
    , ("spec-intrinsic-gas",     "(is-create data-len zero-bytes nonzero-bytes al-addrs al-keys fork-ord)", intrinsicGas)
    , ("spec-code-deposit-gas",  "(nbytes)",                      codeDepositGas)
    , ("spec-create-gas",        "(fork-ord is-create2 initcode-len)", createGas)
    , ("spec-create-initcode-oversize", "(fork-ord initcode-len)",  createInitcodeOversize)  -- EIP-3860 cap
    , ("spec-selfdestruct-refund","(fork-ord)",                   selfdestructRefund)
    , ("spec-calldata-floor-gas","(zero-bytes nonzero-bytes fork-ord)", calldataFloorGas)  -- EIP-7623
    , ("spec-tx-gas-used",       "(gas-used refund-counter zero-bytes nonzero-bytes fork-ord)", txGasUsed)
    , ("spec-selfdestruct-cold-gas","(cold)",                    selfdestructColdGas)  -- EIP-2929
    , ("spec-delegate-access-gas", "(cold)",                     delegateAccessGas)    -- EIP-7702
    , ("spec-retain-63-64",      "(gas fork-ord)",                retain63of64)
    , ("spec-new-account-fee",   "()",                            newAccountFee)
    , ("spec-block-base-reward", "(fork-ord)",                    blockBaseReward)
    , ("spec-uncle-inclusion-bonus","(fork-ord)",                 uncleInclusionBonus)
    , ("spec-uncle-reward",      "(fork-ord uncle-num block-num)", uncleReward)
    , ("spec-effective-gas-price","(max-fee base-fee max-prio)",    effectiveGasPrice)  -- EIP-1559
    -- EIP-4844 blob base fee by the fork's schedule entry (Cancun / EIP-7691 / EIP-7892 BPO1,
    -- BPO2; Evm.CL.GasEmitCancun proves it Evm.Osaka.Spec.calculateBlobGasPriceAt)
    , ("spec-blob-base-fee",     "(excess-blob-gas fork-ord)",      blobBaseFee)
    , ("spec-max-blob-gas-per-block", "(fork-ord)",                 maxBlobGasPerBlock)   -- blobGasUsed cap
    , ("spec-tx-max-gas-limit",  "()",                              txMaxGasLimit)        -- EIP-7825 (Osaka+)
    -- EELS validate_header against the parent header, every fork: the code of the first
    -- clause that raises, 0 = valid (Evm.CL.HeaderEmit.headerViolation_eq_spec; the base fee
    -- and the excess blob gas inside it by Evm.CL.GasEmitLondon / GasEmitCancun)
    , ("spec-header-violation",
       "(number timestamp gas-limit gas-used extra-len difficulty nonce base-fee excess-blob-gas parent-number parent-timestamp parent-gas-limit parent-gas-used parent-difficulty parent-base-fee parent-excess-blob-gas parent-blob-gas-used extra-is-dao ommers-empty parent-has-ommers london-fork-block fork-ord)",
       Evm.CL.HeaderEmit.headerViolation)
    -- Ethereum mainnet fork schedule (Evm.Forks.ofBlock; proved in Evm.CL.ForkEmit)
    , ("spec-mainnet-fork-ord",  "(n ts)",                        Evm.CL.ForkEmit.mainnetForkOrd)
    -- Circle Arc native-USDC precompiles (Evm.Arc.Spec.NativeCoin; arc-nodee76402).
    -- Circle Arc post-block compute_gas_values (Evm.Arc.Spec.BlockSystem; proved = the spec)
    , ("spec-arc-smoothed-gas-used", "(gas-used smoothed-parent alpha have-params)", Evm.Arc.Spec.BlockSystem.smoothedGasUsedExpr)
    , ("spec-arc-next-base-fee", "(gas-used gas-limit base-fee smoothed-parent have-params alpha k-rate inv-elasticity min-fee max-fee)", Evm.Arc.Spec.BlockSystem.nextBaseFeeExpr)
    , ("spec-arc-native-transfer-gas", "(bl-from-cold bl-to-cold amount-pos from-cold to-cold to-empty self)", Evm.Arc.Spec.NativeCoin.transferGas)
    , ("spec-arc-is-blocklisted-gas",  "(slot-cold)",  Evm.Arc.Spec.NativeCoin.isBlocklistedGas)
    , ("spec-arc-early-revert-penalty","()",          Evm.Arc.Spec.NativeCoin.earlyRevertPenaltyExpr)
    , ("spec-arc-precompile-sstore-gas","()",         Evm.Arc.Spec.NativeCoin.precompileSstoreGasExpr)
    , ("spec-arc-empty-account-gas",   "()",          Evm.Arc.Spec.NativeCoin.emptyAccountGasExpr)
    , ("spec-arc-transfer-log-gas",    "()",          Evm.Arc.Spec.NativeCoin.transferLogGasExpr)
    , ("spec-arc-account-load-gas",    "(cold)",      Evm.Arc.Spec.NativeCoin.accountLoadGasExpr)
    , ("spec-arc-slot-read-gas",       "(cold)",      Evm.Arc.Spec.NativeCoin.slotReadGasExpr)
    , ("spec-arc-write-gas",           "(same-as-present original-is-present original-zero)", Evm.Arc.Spec.NativeCoin.writeGasExpr)
    , ("spec-arc-call-stipend",        "()",          Evm.Arc.Spec.NativeCoin.callStipendExpr)
    , ("spec-arc-abi-copy-gas",        "(words)",     Evm.Arc.Spec.NativeCoin.abiCopyGasExpr)
    , ("spec-arc-subcall-dispatch-cost","()",         Evm.Arc.Spec.NativeCoin.subcallDispatchCostExpr)
    , ("spec-arc-blocklist-event-gas", "()",          Evm.Arc.Spec.NativeCoin.blocklistEventGasExpr)
    , ("spec-arc-write-probe-gas",     "(cold)",      Evm.Arc.Spec.NativeCoin.writeProbeGasExpr)
      -- Arc PQ precompile 0x1800…0004 (Evm.Arc.Spec.Pq; arc-node 6e76402).
    , ("spec-arc-pq-verify-gas",       "(msg-words)", Evm.Arc.Spec.Pq.verifyGas)
    , ("spec-arc-pq-base-gas",         "()",          Evm.Arc.Spec.Pq.verifyBaseGasExpr)
    , ("spec-arc-pq-msg-word-gas",     "()",          Evm.Arc.Spec.Pq.gasPerMsgWordExpr)
    , ("spec-arc-pq-vk-len",           "()",          Evm.Arc.Spec.Pq.vkLenExpr)
    , ("spec-arc-pq-sig-len",          "()",          Evm.Arc.Spec.Pq.sigLenExpr) ]
  for (name, args, e) in defs do
    IO.println s!"(defun {name} {args} {e.toCL})"
  -- EIP-2537 MSM gas does not fit the Expr IR: it is a 128-entry table lookup. The
  -- table is emitted verbatim from the Lean list, so the DATA cannot drift from the
  -- spec, and the surrounding arithmetic is the same closed form as `msmGas`
  -- (k · base · discount(k) / 1000, floor). Regenerate, never hand-edit.
  IO.println ""
  for (nm, per, base, ds, maxD) in
      [ ("bls-g1msm", 160, blsG1MsmBase, blsG1MsmDiscounts, blsG1MsmMaxDiscount)
      , ("bls-g2msm", 288, blsG2MsmBase, blsG2MsmDiscounts, blsG2MsmMaxDiscount) ] do
    IO.println s!"(defparameter +{nm}-discounts+ #({String.intercalate " " (ds.map toString)}))"
    IO.println s!"(defun spec-{nm}-gas (len)"
    IO.println s!"  (let ((k (floor len {per})))"
    IO.println s!"    (if (zerop k) 0"
    IO.println s!"        (floor (* k {base} (if (<= k 128) (aref +{nm}-discounts+ (1- k)) {maxD})) 1000))))"
