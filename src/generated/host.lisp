;; A block's own credits after its txs (Evm.CL.EffectBlock.credits): the block and
;; ommer rewards (to London), the EIP-4895 withdrawals (from Shanghai). Proved equal to
;; every fork's Evm.Frontier.Vm.Block.postBlock in Evm.CL.EffectBlockProof.
(defun spec-block-credits (coinbase number uncles withdrawals)
  (let ((%gas 0))
    (when (not (>= *fork-ord* 14))
      (block-credit! coinbase (+ (spec-block-base-reward *fork-ord*) (* (length uncles) (spec-uncle-inclusion-bonus *fork-ord*))))
      (loop for (p-addr . p-n) in uncles
            do (progn
                  (block-credit! p-addr (spec-uncle-reward *fork-ord* p-n number)))))
    (when (>= *fork-ord* 15)
      (loop for (p-addr . p-n) in withdrawals
            do (progn
                  (block-credit! p-addr (* p-n 1000000000))
                  (when (world-account-empty-p p-addr)
                    (account-delete! *current-world* p-addr)))))
    %gas))

;; The JIT dispatch table (RunProgramDenote.build; = the manifest scan: tableLookup_build).
;; The replay's JIT loader and tests/audit-jit.lisp call it; the caller frees the table.
(defun spec-dispatch-table (pairs)
  (let ((n 0))
    (loop for (pc . fn) in pairs
          do (when (zerop fn) (error "spec-dispatch-table: chunk at pc ~D has address 0" pc))
             (setf n (max n (+ pc 1))))
    (let ((tab (foreign-funcall "calloc" :size (1+ n) :size 8 :pointer)))
      (when (null-pointer-p tab) (error "spec-dispatch-table: calloc ~D words failed" (1+ n)))
      (setf (mem-aref tab :uint64 0) n)
      (loop for (pc . fn) in pairs for slot = (mem-aref tab :uint64 (1+ pc))
            do (setf (mem-aref tab :uint64 (1+ pc)) (if (< 0 slot) slot fn)))
      tab)))
;; The (pc . fn) pairs of a `_eita_jit_entries` manifest {count; (pc, fn)...} (JIT.entriesTable).
(defun spec-manifest-pairs (entries)
  (loop for k below (mem-aref entries :uint64 0)
        collect (cons (mem-aref entries :uint64 (+ 1 (* 2 k)))
                      (mem-aref entries :uint64 (+ 2 (* 2 k))))))

;; CL-side revert-journal-to dispatch (world-state entry types;
;; native types are reverted by eita_ts_revert).
(defun spec-restore-journal-entry (type addr slot old)
  (declare (ignorable slot old))
  (case type
    (0 (setf (storage-of *current-world* addr slot) old))
    (2 (if (zerop old) (balance-clear! *current-world* addr) (setf (balance-of *current-world* addr) old)))
    (3 (unmark-destroyed! addr))
    (9 (if (zerop old) (nonce-clear! *current-world* addr) (setf (nonce-of *current-world* addr) old)))
    (10 (account-uncreate! *current-world* addr old))
    (11 (account-unmark! *current-world* addr))
    (12 (untouch! addr))))

;; BLOCKHASH validity window (EELS block_hash): n < cur AND cur <= n+256
;; (oldest valid block = cur-256, inclusive). No subtraction => the #265
;; off-by-one is unrepresentable.
(defun spec-blockhash-valid (n cur)
  (and (< n cur) (<= cur (+ n 256))))

