                                              (observe-revert! snap-facts)
                                              (incf %gas (max 0 (- gas-limit intrinsic)))
                                              (setf %out 0))
                                            (progn
                                              (if (eq (child-status r) :revert)
                                                  (progn
                                                    (revert-journal-to (current-arena) snap)
                                                    (observe-revert! snap-facts)
                                                    (incf %gas (max 0 (- (max 0 (- gas-limit intrinsic)) (child-gas r))))
                                                    (setf %out 0))
                                                  (progn
                                                    (when (and (world-account-present-p target) (world-account-empty-p target))
                                                      (touch! target))
                                                    (incf %gas (max 0 (- (max 0 (- gas-limit intrinsic)) (child-gas r))))
                                                    (setf %out 1)))))))
                                    (progn
                                      (let ((r (run-tx-frame! create sender target (if hasdeleg deleg target) value data block-ctx (max 0 (- gas-limit intrinsic)))))
                                        (setf %child r)
                                        (if (eq (child-status r) :halt)
                                            (progn
