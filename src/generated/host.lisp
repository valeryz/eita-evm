    (fault-account! target)
    (cond ((and checked (zerop (length (code-of *current-world* target)))) (setf %rej 1))
          (t
            (warm-system-seed!)
            (let* ((deleg (and (and prague (not create)) (delegation-target (code-of *current-world* target)))) (hasdeleg (and deleg t)) (deleg (or deleg 0)))
              (declare (ignorable deleg hasdeleg))
