;; (values gas-used flag rejection).
(defun spec-system-effect (target data checked prague block-ctx)
  (let ((sender #xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFE) (create nil) (value 0) (gas-limit 30000000) (intrinsic 0)
        (%gas 0) (%out 0) (%rej 0) (%child nil) (%rd nil))
