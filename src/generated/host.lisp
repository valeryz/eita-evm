                        (progn
                          (when (plusp value)
                            (journal-balance! (current-arena) sender)
                            (setf (balance-of *current-world* sender) (u256 (- (balance-of *current-world* sender) value)))
                            (journal-balance! (current-arena) target)
                            (incf (balance-of *current-world* target) value)
                            (observe-transfer! 0 *call-depth* sender target value))
                          (if (and *chain-precompile-p* (funcall *chain-precompile-p* target))
                              (multiple-value-bind (%ok %used) (chain-tx-precompile! target sender data (max 0 (- gas-limit intrinsic)) value snap snap-facts)
                                (incf %gas %used)
                                (setf %out (if %ok 1 0) %child (list (cond (%ok :return) ((< %used (max 0 (- gas-limit intrinsic))) :revert) (t :halt)) 0 nil)))
                              (progn
